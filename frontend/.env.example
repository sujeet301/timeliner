# Base URL of the Phase 1 backend API
VITE_API_BASE_URL=http://localhost:5000/api

# Google OAuth 2.0 Client ID (type "Web application") from Google Cloud
# Console > APIs & Services > Credentials. Add this app's origin (e.g.
# http://localhost:5173) under "Authorized JavaScript origins".
# Leave unset and the Google button will show a disabled placeholder instead
# of crashing.
VITE_GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
