########################################
# SERVER
########################################
NODE_ENV=development
PORT=5000
# Comma-separated list of origins allowed to call this API (CORS).
# In production this MUST exactly match your deployed frontend's origin
# (scheme + host, no trailing slash) — e.g.:
#   CLIENT_ORIGIN=https://your-frontend.onrender.com
# You can list more than one (e.g. production + a preview URL):
#   CLIENT_ORIGIN=https://app.example.com,https://staging.example.com
# NOTE: whenever NODE_ENV=production and the frontend is on a *different*
# domain than this API, the refresh-token cookie is sent as SameSite=None
# (see utils/generateTokens.js), which browsers require to be Secure —
# meaning this API must be served over HTTPS in production (Render's
# default *.onrender.com domains already are).
CLIENT_ORIGIN=http://localhost:5173

########################################
# DATABASE
########################################
MONGO_URI=mongodb://127.0.0.1:27017/task_reminder_db

########################################
# JWT AUTH
########################################
# Use long, random, unguessable strings in real deployments
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_SECRET=replace_with_a_different_long_random_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d
# Cookie max age in milliseconds, should match refresh token lifetime above
JWT_REFRESH_COOKIE_MAX_AGE_MS=604800000

# Token used to sign password-reset / email-verification links (can reuse access secret if desired)
PASSWORD_RESET_TOKEN_EXPIRES_MIN=30

########################################
# EMAIL (Nodemailer)
# Works with Gmail (use an App Password, not your normal password),
# any SMTP provider, or SendGrid's SMTP relay.
########################################
EMAIL_FROM="Task Reminder <no-reply@taskreminder.app>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username@example.com
SMTP_PASS=your_smtp_password_or_app_password

########################################
# SMS (Twilio)
########################################
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+15551234567

########################################
# GOOGLE SIGN-IN
# Create an OAuth 2.0 Client ID (type "Web application") in Google Cloud
# Console > APIs & Services > Credentials. Add your frontend origin (e.g.
# http://localhost:5173) under "Authorized JavaScript origins". No client
# secret is needed — the frontend uses Google Identity Services to get an
# ID token, and this server only verifies it.
########################################
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com

########################################
# LEETCODE REMINDER
# How often the daily "did you solve anything today" check runs. It doesn't
# need per-minute precision — every 15 minutes is plenty for a once-a-day nudge.
########################################
LEETCODE_REMINDER_CRON_EXPRESSION=*/15 * * * *

########################################
# SCHEDULER
########################################
# Cron expression for how often the reminder scheduler checks for due reminders
REMINDER_CRON_EXPRESSION=* * * * *
# Max attempts before a reminder is permanently marked "failed" and stops retrying
REMINDER_MAX_ATTEMPTS=3

########################################
# RATE LIMITING
########################################
AUTH_RATE_LIMIT_WINDOW_MIN=15
AUTH_RATE_LIMIT_MAX=20
