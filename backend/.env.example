NODE_ENV=development
PORT=5000
# Comma-separated list of origins allowed to call this API (CORS).
# In production this MUST exactly match your deployed frontend's origin —
# e.g. CLIENT_ORIGIN=https://your-frontend.onrender.com
# NOTE: whenever NODE_ENV=production and the frontend is on a different
# domain than this API, the refresh-token cookie is sent as SameSite=None,
# which requires this API to be served over HTTPS in production.
CLIENT_ORIGIN=http://localhost:5173

MONGO_URI=mongodb://127.0.0.1:27017/task_reminder_db

JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_COOKIE_MAX_AGE_MS=604800000
PASSWORD_RESET_TOKEN_EXPIRES_MIN=30

EMAIL_FROM="Task Reminder <no-reply@taskreminder.app>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username@example.com
SMTP_PASS=your_smtp_password_or_app_password

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+15551234567

# Google OAuth 2.0 Client ID (type "Web application"). No client secret
# needed — the frontend uses Google Identity Services to get an ID token,
# and this server only verifies it.
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com

LEETCODE_REMINDER_CRON_EXPRESSION=*/15 * * * *

REMINDER_CRON_EXPRESSION=* * * * *
REMINDER_MAX_ATTEMPTS=3

AUTH_RATE_LIMIT_WINDOW_MIN=15
AUTH_RATE_LIMIT_MAX=20
