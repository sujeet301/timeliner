########################################
# SERVER
########################################
NODE_ENV=development
PORT=5000
# Comma-separated list of origins allowed to call this API (CORS)
CLIENT_ORIGIN=http://localhost:5173

########################################
# DATABASE
########################################
MONGO_URI=mongodb://127.0.0.1:27017/task_reminder_db

########################################
# JWT AUTH
########################################
# Use long, random, unguessable strings in real deployments
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_SECRET=replace_with_a_different_long_random_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d
# Cookie max age in milliseconds, should match refresh token lifetime above
JWT_REFRESH_COOKIE_MAX_AGE_MS=604800000

# Token used to sign password-reset / email-verification links (can reuse access secret if desired)
PASSWORD_RESET_TOKEN_EXPIRES_MIN=30

########################################
# EMAIL (Nodemailer)
# Works with Gmail (use an App Password, not your normal password),
# any SMTP provider, or SendGrid's SMTP relay.
########################################
EMAIL_FROM="Task Reminder <no-reply@taskreminder.app>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username@example.com
SMTP_PASS=your_smtp_password_or_app_password

########################################
# SMS (Twilio)
########################################
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+15551234567

########################################
# SCHEDULER
########################################
# Cron expression for how often the reminder scheduler checks for due reminders
REMINDER_CRON_EXPRESSION=* * * * *
# Max attempts before a reminder is permanently marked "failed" and stops retrying
REMINDER_MAX_ATTEMPTS=3

########################################
# RATE LIMITING
########################################
AUTH_RATE_LIMIT_WINDOW_MIN=15
AUTH_RATE_LIMIT_MAX=20
